rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // SECURITY: delete is intentionally blocked on the client.
      // Account deletion is performed exclusively by the deleteUserData Cloud Function
      // (Admin SDK), which bypasses rules. Blocking here prevents the delete-then-recreate
      // tier elevation attack.
      allow delete: if false;

      // SECURITY: create enforces tier: "free", blocks tierUpdatedAt, and caps trialEndsAt
      // to at most 8 days from now (7-day trial + 1-day clock skew buffer).
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.tier == "free"
                    && !('tierUpdatedAt' in request.resource.data.keys())
                    && request.resource.data.trialEndsAt is timestamp
                    && request.resource.data.trialEndsAt <= request.time + duration.value(8, 'd');

      // Clients cannot directly modify tier, tierUpdatedAt, or trialEndsAt (Cloud Function is the only writer).
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && !('tier' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('tierUpdatedAt' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('trialEndsAt' in request.resource.data.diff(resource.data).affectedKeys());

      match /games/{gameId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        // SECURITY: Enforce structural constraints and data size limits.
        // Prevents storage abuse and malformed data that could crash other devices.
        //
        // The players ceiling sits DELIBERATELY ABOVE the app's own cap
        // (PRO_PLAYER_CAP = 50 in frontend/utils/tierLimits.ts) so the product
        // number can rise without another rules deploy, while this stays a
        // storage-abuse guard: 100 players is ~11% of the 1 MiB document limit.
        //
        // One-way door: once users hold games at a given size, this ceiling can
        // never drop below their largest game without breaking their writes. A
        // game over the ceiling fails with permission-denied, which is NOT an
        // offline error, so the fire-and-forget write only logs a console warning
        // and the game silently never leaves the device.
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['id', 'name', 'status'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && request.resource.data.status in ['active', 'completed']
          && request.resource.data.players is list
          && request.resource.data.players.size() <= 100;
      }

      match /savedPlayers/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        // SECURITY: size cap (PRO ceiling) guards against storage abuse.
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.players is list
          && request.resource.data.players.size() <= 200;
      }
    }

    // -----------------------------------------------------------------------
    // Shared game links — the ONLY cross-user read path in this database.
    //
    // The document holds a frozen, presentational projection of a completed
    // game (see frontend/utils/sharedGameSnapshot.ts). The 20-character
    // auto-ID IS the credential: unguessable at ~119 bits, and unlisted.
    //
    // ownerUid sits at document level and IS readable by any viewer, because
    // `get` covers the whole document. Accepted, not overlooked: the delete and
    // update rules need it, and a Firebase uid grants nothing on its own —
    // /users/{uid} reads already require request.auth.uid == uid.
    //
    // Documents expire via a native TTL policy on expiresAt (a console/gcloud
    // setting, no Cloud Function) -- specifically, a TTL policy on the
    // `expiresAt` field of the `sharedGames` collection group. Nothing in
    // this repo creates that policy: it must be set by hand, once, via the
    // Firebase console or `gcloud firestore fields ttls update`, and
    // re-checked after any project migration. Until it exists, expired
    // documents stay readable past their nominal 30-day expiry.
    // -----------------------------------------------------------------------
    match /sharedGames/{shareId} {

      // Storage-abuse guard, applied to create AND update alike via
      // validSnapshot() plus hasRequiredKeys() below. What this ACTUALLY
      // bounds: array COUNTS on balances (<=100) and settlements (<=500),
      // gameName's total character count (<=100), the TYPE of each of those
      // three fields (list/list/string — a string can otherwise satisfy
      // size() too, silently passing a malformed snapshot), and the exact
      // key set at BOTH the document top level (hasRequiredKeys below) AND
      // inside snapshot itself, via hasOnly against the exact shape shipped
      // in frontend/utils/sharedGameSnapshot.ts's SharedGameSnapshot
      // interface (bankerName/bankerPlayerId stay optional because hasOnly
      // permits a subset of the listed keys). Without the snapshot-level
      // hasOnly, an arbitrary extra key inside snapshot — e.g.
      // snapshot.junk holding ~900 KB — smuggled in payload exactly like an
      // extra top-level key did before hasRequiredKeys(). What this does
      // NOT and CANNOT bound: the byte size of any individual string INSIDE
      // an array element — e.g. one balance's playerName. Firestore
      // security rules have no iteration construct, so per-element field
      // lengths inside the balances/settlements arrays cannot be capped
      // here; that residual is real, and its only backstop is Firestore's
      // own 1 MiB total document size limit. Every other field, at either
      // key level, IS bounded by count, type, or key-set exclusivity — this
      // is a partial guard with one specific, named hole, not a guard
      // against "anything inside snapshot".
      function validSnapshot(data) {
        return data.snapshot.keys().hasOnly(
                 ['gameName', 'date', 'currency', 'settlementMode', 'bankerName',
                  'bankerPlayerId', 'totalPot', 'balances', 'settlements', 'payments'])
               && data.snapshot.balances is list
               && data.snapshot.balances.size() <= 100
               && data.snapshot.settlements is list
               && data.snapshot.settlements.size() <= 500
               && data.snapshot.gameName is string
               && data.snapshot.gameName.size() <= 100;
      }

      // Required-shape guard, applied to create AND update alike. hasAll
      // stops a required top-level field (ownerUid/snapshot/createdAt/
      // expiresAt/schema) from being silently absent; hasOnly stops an
      // arbitrary extra top-level field from being smuggled in (hasAll alone
      // checks presence, not exclusivity, so it would not catch a payload
      // with all required fields PLUS a 900 KB extra one).
      function hasRequiredKeys(data) {
        return data.keys().hasAll(['ownerUid', 'snapshot', 'createdAt', 'expiresAt', 'schema'])
               && data.keys().hasOnly(['ownerUid', 'snapshot', 'createdAt', 'expiresAt', 'schema']);
      }

      // The URL IS the credential — the ~119-bit id is what actually gates
      // who can find this document. request.auth != null is defense in depth
      // on top of that, not a replacement for it: Task 10's auth gate
      // (resolveAuthRedirect) sends a signed-out visitor to /(auth)/login
      // BEFORE the shared route ever renders, even with a pending share
      // waiting — and the doormat page performs no Firestore read at all. So
      // there is no reader in this system that is ever unauthenticated at
      // read time; requiring auth here costs nothing and narrows the grant
      // on the one rule that governs cross-user data.
      //
      // expiresAt > request.time: an expired link stays intact until the TTL
      // sweeper happens to run, but must stop being READABLE immediately —
      // recipients are told links last 30 days, and the rules must enforce
      // that on read, not just rely on eventual deletion.
      allow get: if request.auth != null && resource.data.expiresAt > request.time;

      // LOAD-BEARING. Without this, any caller — authenticated or not — can
      // enumerate every shared game ever created: names, amounts and payment
      // handles included. A ~119-bit unlisted id is only a secret if it can
      // never be discovered by iteration or query. Do not relax this for any
      // feature; a "Shared with me" list is explicitly out of scope for
      // exactly this reason.
      allow list: if false;

      // Document-ID format guard. shareId must be exactly the 20-character
      // [A-Za-z0-9] Firestore auto-ID shape the app itself mints (see
      // frontend/utils/shareLink.ts SHARE_ID_RE). Without this a client could
      // create a document at a short, guessable id like /sharedGames/abc,
      // voiding the "URL is the credential" security model, because an
      // attacker could then enumerate short ids directly. matches() on
      // Firestore rules uses RE2 and is fully anchored by default; the ^...$
      // is written explicitly anyway so the intent survives a copy-paste.
      allow create: if request.auth != null
                    && shareId.matches('^[A-Za-z0-9]{20}$')
                    // Explicit shape guard, not just a side effect of
                    // validSnapshot() erroring on an absent field: a future
                    // edit that reorders or guards those dereferences could
                    // otherwise silently turn a missing-field deny into an
                    // allow with the test still green for the wrong reason.
                    && hasRequiredKeys(request.resource.data)
                    && request.resource.data.ownerUid == request.auth.uid
                    && validSnapshot(request.resource.data)
                    // A document born already expired must never be
                    // writable — there is no legitimate reason to create a
                    // dead link.
                    && request.resource.data.expiresAt > request.time
                    // One day of clock skew over the 30-day policy. Stops a
                    // client writing a snapshot that outlives the TTL window.
                    && request.resource.data.expiresAt <= request.time + duration.value(31, 'd');

      // Owner-only, NOT forbidden. The invariant that matters is "exactly one
      // writer, never a viewer" — which the ownerUid check gives in full, so the
      // multi-writer problem the frozen-snapshot design exists to avoid stays
      // impossible. Forbidding update outright was over-tight: a host who
      // reopens and re-completes a game (the statsCounted path exists for this)
      // could never correct a link already sitting in a group chat.
      //
      // "Frozen" means frozen against viewers and against concurrency, not
      // immutable forever. Runs the same validSnapshot() AND hasRequiredKeys()
      // checks as create — deliberately stronger than spec §4, which
      // re-asserts ownerUid on update but drops the size caps, which would
      // let an owner refresh a 10-row link into a 10,000-row document and
      // bypass the storage guard entirely. hasRequiredKeys() on update closes
      // a second hole in the same spirit: without it an owner could DROP
      // createdAt or schema via update with nothing else in this rule
      // noticing (verified: mutation-tested, both drop silently without
      // hasAll). Dropping expiresAt specifically was ALREADY denied even
      // before this guard, because the expiresAt-upper-bound clause below
      // already dereferences request.resource.data.expiresAt and fails
      // closed on an absent field — hasRequiredKeys() makes that robust
      // against a future refactor of that clause rather than being the only
      // thing stopping it today.
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && hasRequiredKeys(request.resource.data)
                    && validSnapshot(request.resource.data)
                    && request.resource.data.expiresAt <= request.time + duration.value(31, 'd');

      // No UI calls delete today. Shipped anyway: it costs nothing and the
      // tests assert it.
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
